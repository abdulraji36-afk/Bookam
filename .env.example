# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public address of the app, used in invite and email-confirmation links.
# Optional in development; set it in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram notifications (optional). Create a bot with @BotFather, then set
# these and register the webhook once (see README).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
